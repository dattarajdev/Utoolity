NODE_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
FRONTEND_URL=http://192.168.1.100:2026
SESSION_SECRET=YOUR_GENERATED_SECRET
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgresql://utoolity_app:YOUR_PASSWORD@127.0.0.1:5432/utoolity
PG_POOL_MAX=10
PG_SSL=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=true
BACKEND_DATA_DIR=./data
LOG_LEVEL=info